exports[`csr snapshot test > csr test ./packages/components/table/_example/custom-col.vue 1`] = `
<div
  class="tdesign-demo-block-column-large"
>
  <!-- 按钮操作区域 -->
  <div
    class="t-space t-space-align-center t-space-horizontal"
    style="gap: 16px;"
  >
    
    
    <div
      class="t-space-item"
    >
      <button
        class="t-button t-button--variant-base t-button--theme-primary"
        href=""
        tabindex="0"
        type="button"
      >
        <span
          class="t-button__text"
        >
          
          显示列配置弹窗
          
        </span>
      </button>
    </div>
    <!---->
    
    
    <div
      class="t-space-item"
    >
      <label
        class="t-checkbox t-is-checked"
        tabindex="0"
      >
        
        <input
          class="t-checkbox__former"
          tabindex="-1"
          type="checkbox"
        />
        <span
          class="t-checkbox__input"
        />
        <span
          class="t-checkbox__label"
        >
          
          分组列配置
          
        </span>
        
      </label>
    </div>
    <!---->
    
    
  </div>
  <!-- 1. defaultDisplayColumns = ['platform'] 设置默认显示哪些列，仅第一次有效 -->
  <!-- 2. displayColumns 动态设置显示哪些列，受控属性，支持 displayColumns.sync 语法糖 -->
  <!-- 3. onDisplayColumnsChange 当前显示列发生变化时触发 -->
  <!-- :locale="tableLocale" 可用于定义列配置弹框所有文本信息 -->
  <div
    class="t-table t-table--striped t-table--column-resizable"
    columncontrollervisible="false"
    displaycolumns="applicant,status,channel,detail.email,createTime"
    tabindex="0"
  >
    <!---->
    <!---->
    <div
      class="t-table__content"
    >
