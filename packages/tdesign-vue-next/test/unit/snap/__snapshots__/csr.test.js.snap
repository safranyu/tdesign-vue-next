exports[`csr snapshot test > csr test ./packages/components/table/_example/fixed-header-col.vue 1`] = `
<div
  data-v-app=""
>
  
  <!-- 父元素宽度不能超过 100% -->
  <div
    class="tdesign-demo-block-column"
    style="width: 100%;"
  >
    <div>
      <div
        class="t-radio-group t-size-m t-radio-group--filled"
      >
        
        <label
          class="t-radio-button t-is-checked"
          tabindex="0"
        >
          <input
            class="t-radio-button__former"
            data-value="'fixed'"
            name=""
            tabindex="-1"
            type="radio"
            value="fixed"
          />
          <span
            class="t-radio-button__input"
          />
          <span
            class="t-radio-button__label"
          >
            
            
            table-layout: fixed
            
            
          </span>
        </label>
        <label
          class="t-radio-button"
          tabindex="0"
        >
          <input
            class="t-radio-button__former"
            data-value="'auto'"
            name=""
            tabindex="-1"
            type="radio"
            value="auto"
          />
          <span
            class="t-radio-button__input"
          />
          <span
            class="t-radio-button__label"
          >
            
            
            table-layout: auto
            
            
          </span>
        </label>
        
        <div
          class="t-radio-group__bg-block"
          style="width: 0px; height: 0px; left: 0px; top: 0px; transition-property: none;"
        />
      </div>
    </div>
    <div>
      <label
        class="t-checkbox"
        tabindex="0"
      >
        
        <input
          class="t-checkbox__former"
          tabindex="-1"
          type="checkbox"
        />
        <span
          class="t-checkbox__input"
        />
        <span
          class="t-checkbox__label"
        >
          
