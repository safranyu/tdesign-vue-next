                class="t-table__th-cell-inner"
              >
                申请人
              </div>
            </th>
            <th
              class="t-table__th-status"
              data-colkey="status"
            >
              <div
                class="t-table__th-cell-inner"
              >
                申请状态
              </div>
            </th>
            <th
              class="t-table__th-channel"
              data-colkey="channel"
            >
              <div
                class="t-table__th-cell-inner"
              >
